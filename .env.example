# Copy to .env and fill in. Never commit .env.

# OpenAI. With a Vocareum gateway key (starts with "voc-"), set the gateway URL.
# With a personal OpenAI key, use https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openai.vocareum.com/v1

# LangFuse Cloud (EU host shown; US projects use https://us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Models
LLM_MODEL=gpt-4o-mini
# DeepEval judge; empty means the same as LLM_MODEL
JUDGE_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Kill switch: false runs the rules-only mode (Req. FR-68)
LLM_ENABLED=true

LOG_LEVEL=INFO
